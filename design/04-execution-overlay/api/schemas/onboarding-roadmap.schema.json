{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmtl.vn/schemas/content/newcomer-onboarding-roadmap.json",
  "title": "NewcomerOnboardingRoadmap",
  "type": "object",
  "required": [
    "publicId",
    "slug",
    "title",
    "intro",
    "durationDays",
    "weeks",
    "completionChecklist",
    "safetyRules",
    "nextActions",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "publicId": {
      "type": "string",
      "minLength": 8
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "durationDays": {
      "type": "integer",
      "const": 30
    },
    "weeks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/roadmapWeek"
      }
    },
    "completionChecklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safetyRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/safetyRule"
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "roadmapWeek": {
      "type": "object",
      "required": [
        "weekNumber",
        "title",
        "goal",
        "tasks",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "weekNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/roadmapTask"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "roadmapTask": {
      "type": "object",
      "required": [
        "taskKey",
        "title",
        "description",
        "taskKind",
        "isRequired",
        "cadence",
        "checklist"
      ],
      "additionalProperties": false,
      "properties": {
        "taskKey": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "taskKind": {
          "type": "string",
          "enum": [
            "recitation",
            "study",
            "ritual",
            "vow",
            "life_release",
            "faq_review"
          ]
        },
        "isRequired": {
          "type": "boolean"
        },
        "cadence": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "one-time"
          ]
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "safetyRule": {
      "type": "object",
      "required": [
        "code",
        "label",
        "description",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        }
      }
    },
    "nextAction": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
