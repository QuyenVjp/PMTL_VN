{
  "name": "pmtl-vn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.30.3"
  },
  "scripts": {
    "dev": "tsx infra/scripts/dev.ts up",
    "dev:core": "tsx infra/scripts/dev.ts up core",
    "dev:full": "tsx infra/scripts/dev.ts up full",
    "dev:logs": "tsx infra/scripts/dev.ts logs",
    "dev:logs:core": "tsx infra/scripts/dev.ts logs core",
    "dev:logs:full": "tsx infra/scripts/dev.ts logs full",
    "dev:stop": "tsx infra/scripts/dev.ts down",
    "dev:rebuild": "tsx infra/scripts/dev.ts rebuild",
    "dev:rebuild:core": "tsx infra/scripts/dev.ts rebuild core",
    "dev:rebuild:full": "tsx infra/scripts/dev.ts rebuild full",
    "dev:host:apps": "turbo run dev --parallel --filter=@pmtl/web",
    "dev:host:admin": "tsx infra/scripts/ensure-port-free.ts 3002 admin && pnpm --filter @pmtl/admin dev",
    "dev:host:admin:clean-ports": "tsx infra/scripts/ensure-port-free.ts 3001 api && tsx infra/scripts/ensure-port-free.ts 3002 admin",
    "dev:host:admin:stack": "pnpm dev:host:admin:clean-ports && turbo run dev --parallel --filter=@pmtl/api --filter=@pmtl/admin",
    "dev:host:full": "turbo run dev --parallel --filter=@pmtl/web --filter=@pmtl/api --filter=@pmtl/admin",
    "dev:host:prepare": "pwsh -ExecutionPolicy Bypass -File ./infra/scripts/prepare-host-dev.ps1",
    "run": "pwsh -ExecutionPolicy Bypass -File ./run-project.ps1",
    "claude:setup": "pwsh -ExecutionPolicy Bypass -File ./infra/scripts/bootstrap-claude-code.ps1",
    "claude:doctor": "pwsh -ExecutionPolicy Bypass -File ./infra/scripts/claude-code-doctor.ps1",
    "admin:run": "pnpm --filter @pmtl/admin dev",
    "dev:host:web": "pnpm --filter @pmtl/web dev",
    "db:reset:dev": "tsx infra/scripts/reset-dev-db.ts",
    "reindex:posts": "echo \"TODO: replace CMS reindex with apps/api search ops\"",
    "smoke:test": "tsx infra/scripts/smoke-test.ts",
    "design:extract:practice-pdfs": "python infra/scripts/extract_practice_pdfs.py",
    "monitoring:test": "tsx infra/scripts/test-monitoring.ts",
    "telegram:test": "tsx infra/scripts/test-telegram.ts",
    "docker:prod:monitoring": "docker compose --env-file infra/docker/.env.prod -f infra/docker/compose.prod.yml --profile monitoring up -d",
    "docker:prod:monitoring:test": "docker compose --env-file infra/docker/.env.prod -f infra/docker/compose.prod.yml --profile monitoring --profile monitoring-test up -d",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:web": "pnpm --filter @pmtl/web test",
    "build:admin": "pnpm --filter @pmtl/admin build",
    "typecheck:admin": "pnpm --filter @pmtl/admin typecheck",
    "typecheck": "turbo run typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "docker:dev": "tsx infra/scripts/dev.ts up --foreground",
    "docker:prod": "docker compose -f infra/docker/compose.prod.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.1.6",
    "globals": "^16.4.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
