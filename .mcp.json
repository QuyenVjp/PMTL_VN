{
  "mcpServers": {
    "corn-hub": {
      "type": "stdio",
      "command": "node",
      "args": [
        "C:\\Users\\ADMIN\\CornMCP\\apps\\corn-mcp\\dist\\cli.js"
      ],
      "env": {
        "DASHBOARD_API_URL": "http://localhost:4000",
        "QDRANT_URL": "http://localhost:6333",
        "MCP_SERVER_NAME": "corn-hub-local",
        "MCP_SERVER_VERSION": "0.1.0",
        "OPENAI_API_KEY": "pa-2Cpmw4cfnW3H8BuMVjpSJP9SHP39nkm4IPOpsCV-zVX",
        "OPENAI_API_BASE": "https://api.voyageai.com/v1",
        "MEM9_EMBEDDING_MODEL": "voyage-code-3"
      }
    },
    "stitch": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: ${STITCH_MCP_API_KEY}"
      ]
    },
    "shadcn": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "shadcn@latest",
        "mcp",
        "--cwd",
        "apps/web"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "openspace": {
      "type": "stdio",
      "command": "C:\\Users\\ADMIN\\DEV2\\PMTL_VN\\tmp\\OpenSpace\\.venv\\Scripts\\openspace-mcp.exe",
      "env": {
        "PYTHONUTF8": "1",
        "OPENSPACE_HOST_SKILL_DIRS": "C:\\Users\\ADMIN\\.codex\\skills,C:\\Users\\ADMIN\\DEV2\\PMTL_VN\\.agents\\skills",
        "OPENSPACE_WORKSPACE": "C:\\Users\\ADMIN\\DEV2\\PMTL_VN\\tmp\\OpenSpace",
        "OPENSPACE_API_KEY": ""
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "next-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server",
        "stdio",
        "--read-only"
      ]
    },
    "meilisearch-admin": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "meilisearch"
      ]
    },
    "redis-admin": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "redis"
      ]
    },
    "sentry-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@sentry/mcp-server@latest",
        "--agent"
      ]
    },
    "grafana": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "grafana"
      ]
    },
    "smartbear": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@smartbear/mcp@latest"
      ]
    },
    "docker-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--transport",
        "stdio"
      ]
    },
    "postgres-pmtl": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "postgres"
      ]
    }
  }
}
