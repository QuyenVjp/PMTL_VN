{
  "mcpServers": {
    "openaiDeveloperDocs": {
      "type": "http",
      "url": "https://developers.openai.com/mcp"
    },
    "stitch": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: ${STITCH_MCP_API_KEY}"
      ]
    },
    "shadcn": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "shadcn@latest",
        "mcp",
        "--cwd",
        "apps/web"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "neural-memory": {
      "type": "stdio",
      "command": "C:\\Users\\ADMIN\\.local\\bin\\nmem-mcp.cmd"
    },
    "prisma-local": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "prisma",
        "mcp"
      ]
    },
    "gitnexus": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "C:\\Users\\ADMIN\\.codex\\tools\\gitnexus\\node_modules\\.bin\\gitnexus.cmd",
        "mcp"
      ]
    },
    "cocoindex_code": {
      "type": "stdio",
      "command": "C:\\Users\\ADMIN\\.local\\bin\\ccc.exe",
      "args": [
        "mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "next-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server",
        "stdio",
        "--read-only"
      ]
    },
    "meilisearch-admin": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "meilisearch"
      ]
    },
    "redis-admin": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "redis"
      ]
    },
    "sentry-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@sentry/mcp-server@latest",
        "--agent"
      ]
    },
    "grafana": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "grafana"
      ]
    },
    "smartbear": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@smartbear/mcp@latest"
      ]
    },
    "postgres-pmtl": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "infra/tools/start_mcp_server.ps1",
        "-Server",
        "postgres"
      ]
    }
  }
}
