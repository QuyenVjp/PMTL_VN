NODE_ENV=development

# Shared
PMTL_DOMAIN=localhost
PMTL_CMS_DOMAIN=cms.localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURITY_RATE_LIMIT_STORE=auto
SECURITY_RATE_LIMIT_MAX=120
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_AUTH_MAX=15
SECURITY_RATE_LIMIT_AUTH_WINDOW_MS=60000
SECURITY_RATE_LIMIT_UPLOAD_MAX=20
SECURITY_RATE_LIMIT_UPLOAD_WINDOW_MS=300000
CMS_PUBLIC_URL=http://localhost:3001
CMS_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTERNAL_WEBHOOK_URL=http://web:3000/api/revalidate
REVALIDATE_SECRET=replace-with-a-long-random-string
AUTH_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Database
POSTGRES_DB=pmtl
POSTGRES_USER=pmtl
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://pmtl:replace-with-a-strong-password@postgres:5432/pmtl

# Search
SEARCH_ENGINE=meilisearch
SEARCH_SQL_FALLBACK_ENABLED=true
SEARCH_TIMEOUT_MS=3000
MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=
MEILI_INDEX_PREFIX=pmtl_
MEILI_MASTER_KEY=replace-with-a-strong-meili-key
MEILISEARCH_BLOG_POST_INDEX=posts
MEILI_POSTS_INDEX=posts
MEILI_SEMANTIC_EMBEDDER=default
MEILI_SEMANTIC_DIMENSIONS=1536
MEILI_SEMANTIC_RATIO=0.35
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Antivirus (optional)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

# Production infrastructure
REDIS_URL=redis://redis:6379
CSRF_SECRET=replace-with-a-long-random-string
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PMTL_VN
WORKER_MAINTENANCE_INTERVAL_MS=600000

# Optional MCP credentials
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOOLSETS=repos,issues,pull_requests,actions
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
GRAFANA_ORG_ID=
SWAGGER_API_KEY=
SWAGGER_PORTAL_BASE_PATH=
SWAGGER_REGISTRY_BASE_PATH=
SWAGGER_UI_BASE_PATH=
BUGSNAG_AUTH_TOKEN=
BUGSNAG_PROJECT_API_KEY=
