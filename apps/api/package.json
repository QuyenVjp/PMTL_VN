{
  "name": "@pmtl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/prepare-test-db.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1021.0",
    "@bull-board/api": "^6.20.6",
    "@bull-board/express": "^6.20.6",
    "@bull-board/nestjs": "^6.20.6",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@prisma/instrumentation": "^7.6.0",
    "@scalar/nestjs-api-reference": "1.1.4",
    "@sentry/node": "^10.47.0",
    "altcha": "^2.3.0",
    "argon2": "0.43.0",
    "bullmq": "^5.71.1",
    "cache-manager": "^7.2.8",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.1.0",
    "express": "5.1.0",
    "file-type": "^22.0.0",
    "helmet": "8.1.0",
    "jose": "6.0.11",
    "keyv": "^5.6.0",
    "nanoid": "5.1.5",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "^8.0.4",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.14.1",
    "pino": "10.3.1",
    "pino-http": "10.5.0",
    "prom-client": "^15.1.3",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "resend": "^6.10.0",
    "rxjs": "7.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.1.17",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "24.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/opossum": "^8.1.9",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.15.2",
    "@types/supertest": "7.2.0",
    "prisma": "7.5.0",
    "supertest": "7.2.2",
    "typescript": "5.9.2",
    "vitest": "4.1.0"
  }
}
