// PMTL Phase 1 schema
// Reference: design/04-execution-overlay/data/PRISMA_SCHEMA_PLAN.md

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["strictUndefinedChecks", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetStatus {
  UPLOADING
  READY
  ORPHANED
  DELETED
}

// ============================================================================
// PLATFORM TABLES
// ============================================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorType  String   @map("actor_type")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitRecord {
  id         String   @id @default(cuid())
  key        String
  endpoint   String
  count      Int      @default(1)
  windowStart DateTime @map("window_start")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([key, endpoint, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_records")
}

// ============================================================================
// IDENTITY TABLES
// ============================================================================

model User {
  id           String     @id @default(cuid())
  publicId     String     @unique @map("public_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions     Session[]
  posts        Post[]
  mediaAssets  MediaAsset[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// CONTENT TABLES
// ============================================================================

model MediaAsset {
  id          String      @id @default(cuid())
  publicId    String      @unique @map("public_id")
  filename    String
  mimeType    String      @map("mime_type")
  size        Int
  storageKey  String      @map("storage_key")
  url         String
  width       Int?
  height      Int?
  status      AssetStatus @default(UPLOADING)
  uploaderId  String      @map("uploader_id")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([uploaderId])
  @@index([status])
  @@map("media_assets")
}

model Post {
  id          String        @id @default(cuid())
  publicId    String        @unique @map("public_id")
  slug        String        @unique
  title       String
  excerpt     String?
  content     Json
  status      ContentStatus @default(DRAFT)
  authorId    String        @map("author_id")
  featuredImageId String?   @map("featured_image_id")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@map("posts")
}

// ============================================================================
// CHANTING ENVIRONMENT RULES
// Canonical rule surface for /niem-kinh/luu-y-moi-truong-va-thoi-gian
// ============================================================================

enum RuleSeverity {
  ADVISORY
  CAUTION
  STRONG_GUARDRAIL
  QUALITY_GUIDANCE
  REFERENCE_ONLY
}

enum RuleProductizationMode {
  WARNING_CARD
  CHECKLIST_ITEM
  SAFE_LANE_SUGGESTION
  DRAWER_NOTE
  REFERENCE_ONLY_NOTE
  DO_NOT_AUTOMATE
}

model ChantEnvironmentRuleGroup {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  groupKey        String   @unique @map("group_key")
  title           String
  summary         String
  sortOrder       Int      @default(0) @map("sort_order")
  lastReviewedAt  DateTime @default(now()) @map("last_reviewed_at")
  versionNote     String?  @map("version_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rules ChantEnvironmentRule[]

  @@map("chant_environment_rule_groups")
}

model ChantEnvironmentRule {
  id                  String                  @id @default(cuid())
  publicId            String                  @unique @map("public_id")
  groupId             String                  @map("group_id")
  ruleKey             String                  @unique @map("rule_key")
  title               String
  canonicalWording    String                  @map("canonical_wording")
  severity            RuleSeverity
  productizationMode  RuleProductizationMode  @map("productization_mode")
  safeLaneRefs        String[]                @default([]) @map("safe_lane_refs")
  avoidItems          String[]                @default([]) @map("avoid_items")
  shortReason         String?                 @map("short_reason")
  sourceReference     String?                 @map("source_reference")
  versionNote         String?                 @map("version_note")
  referenceOnly       Boolean                 @default(false) @map("reference_only")
  sortOrder           Int                     @default(0) @map("sort_order")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  group ChantEnvironmentRuleGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("chant_environment_rules")
}

// ============================================================================
// WEBHOOK DEDUPLICATION
// ============================================================================

model WebhookDelivery {
  id          String   @id @default(cuid())
  provider    String                          // e.g. "stripe", "payos", "cloudflare"
  eventId     String   @map("event_id")       // provider's unique event/delivery ID
  eventType   String   @map("event_type")     // e.g. "payment.completed"
  status      String   @default("PROCESSED")  // PROCESSED | FAILED
  metadata    Json?
  processedAt DateTime @default(now()) @map("processed_at")
  expiresAt   DateTime @map("expires_at")     // TTL for cleanup

  @@unique([provider, eventId])
  @@index([expiresAt])
  @@index([provider, eventType])
  @@map("webhook_deliveries")
}

// ============================================================================
// MODERATION TABLES
// ============================================================================

enum ReportStatus {
  PENDING
  RESOLVED_HIDE
  RESOLVED_IGNORE
  RESOLVED_ESCALATE
}

model ModerationReport {
  id              String       @id @default(cuid())
  publicId        String       @unique @map("public_id")
  reporterUserId  String       @map("reporter_user_id")
  targetType      String       @map("target_type") // "post" | "comment" | "community_post" | "guestbook"
  targetId        String       @map("target_id")
  reasonCode      String       @map("reason_code")
  description     String?
  status          ReportStatus @default(PENDING)
  decisionBy      String?      @map("decision_by")
  decisionAt      DateTime?    @map("decision_at")
  decisionNote    String?      @map("decision_note")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterUserId])
  @@map("moderation_reports")
}
