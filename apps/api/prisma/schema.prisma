  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  lhRecord LhRecord @relation(fields: [lhRecordId], references: [id])

  @@index([lhRecordId])
  @@map("lh_dotting_sessions")
}

model LhCombustionLog {
  id            String   @id @default(cuid())
  lhRecordId    String   @map("lh_record_id")
  burnedAt      DateTime @map("burned_at")
  altitude      String?
  containerType String?  @map("container_type")
  operatorName  String?  @map("operator_name")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  lhRecord LhRecord @relation(fields: [lhRecordId], references: [id])

  @@index([lhRecordId])
  @@map("lh_combustion_logs")
}

model LhFraud {
  id         String    @id @default(cuid())
  lhRecordId String    @map("lh_record_id")
  flaggedAt  DateTime  @default(now()) @map("flagged_at")
  reason     String
  severity   String    @default("MEDIUM")
  resolvedAt DateTime? @map("resolved_at")
  resolution String?
  createdAt  DateTime  @default(now()) @map("created_at")

  lhRecord LhRecord @relation(fields: [lhRecordId], references: [id])

  @@index([lhRecordId])
  @@index([severity, resolvedAt])
  @@map("lh_fraud_logs")
}

// ─── SACRED-FORMS: Enums ─────────────────────────────────────────────────────

enum SacredFormType {
  REFUGE_FORM
  VOW_FORM
  MERIT_TRANSFER_FORM
  RECITATION_CERTIFICATE
  DHARMA_STUDY_FORM
}

enum SacredFormPrerequisiteStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum SacredFormApplicantStatus {
  PENDING
  UNDER_REVIEW
  PROBATION
  APPROVED
  REJECTED
  REVOKED
}

// ─── SACRED-FORMS: Models ────────────────────────────────────────────────────

model SacredFormTemplate {
  id               String         @id @default(cuid())
  publicId         String         @unique @map("public_id")
  formType         SacredFormType @map("form_type")
  titleVi          String         @map("title_vi")
  titleZh          String?        @map("title_zh")
  description      String?
  prerequisitesDef Json?          @map("prerequisites_def")
  formSchema       Json?          @map("form_schema")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  applicants FormApplicant[]

  @@index([formType, isActive])
  @@map("sacred_form_templates")
}

model FormApplicant {
  id              String                    @id @default(cuid())
  publicId        String                    @unique @map("public_id")
  templateId      String                    @map("template_id")
  userId          String                    @map("user_id")
  status          SacredFormApplicantStatus @default(PENDING)
  formData        Json?                     @map("form_data")
  probationEndsAt DateTime?                 @map("probation_ends_at")
  approvedAt      DateTime?                 @map("approved_at")
  rejectedAt      DateTime?                 @map("rejected_at")
  revokedAt       DateTime?                 @map("revoked_at")
  reviewNotes     String?                   @map("review_notes")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  template             SacredFormTemplate      @relation(fields: [templateId], references: [id])
  user                 User                    @relation("sacredFormApplicants", fields: [userId], references: [id])
  prerequisites        FormPrerequisiteEntry[]
  auditLogs            SacredFormAuditLog[]
  nameChangeProbation  NameChangeProbation?

  @@index([userId, status])
  @@index([templateId])
  @@map("form_applicants")
}

model FormPrerequisiteEntry {
  id          String                       @id @default(cuid())
  applicantId String                       @map("applicant_id")
  name        String
  status      SacredFormPrerequisiteStatus @default(NOT_STARTED)
  completedAt DateTime?                    @map("completed_at")
  evidence    String?
  createdAt   DateTime                     @default(now()) @map("created_at")

  applicant FormApplicant @relation(fields: [applicantId], references: [id])

  @@index([applicantId])
  @@map("form_prerequisite_entries")
}

model SacredFormAuditLog {
  id          String   @id @default(cuid())
  applicantId String   @map("applicant_id")
  actor       String
  action      String
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  applicant FormApplicant @relation(fields: [applicantId], references: [id])

  @@index([applicantId, createdAt(sort: Desc)])
  @@map("sacred_form_audit_logs")
}

model DisposalPolarityRecord {
  id          String   @id @default(cuid())
  formType    String   @map("form_type")
  polarity    String
  rationale   String?
  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([formType])
  @@map("disposal_polarity_records")
}

model NameChangeProbation {
  id                    String   @id @default(cuid())
  publicId              String   @unique @map("public_id")
  formApplicantId       String   @unique @map("form_applicant_id")
  userId                String   @map("user_id")
  oldDharmaName         String?  @map("old_dharma_name")
  newDharmaName         String?  @map("new_dharma_name")
  probationStartDate    DateTime @map("probation_start_date")
  probationDurationDays Int      @default(100) @map("probation_duration_days")
  probationEndDate      DateTime @map("probation_end_date")
  isActive              Boolean  @default(true) @map("is_active")
  restrictionDetails    String?  @map("restriction_details")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  formApplicant FormApplicant @relation(fields: [formApplicantId], references: [id])
  user          User          @relation("nameChangeProbations", fields: [userId], references: [id])

  @@index([userId, isActive], name: "idx_probations_user_active")
  @@index([probationEndDate, isActive], name: "idx_probations_end_date")
  @@map("name_change_probations")
}

// ─── ALTAR-MANAGEMENT: Enums ─────────────────────────────────────────────────

enum AltarItemType {
  INCENSE_BURNER
  CANDLE_HOLDER
  FLOWER_VASE
  WATER_CUP
  FRUIT_PLATE
  STATUE
  LAMP
  BELL
  OTHER
}

enum AltarConditionStatus {
  GOOD
  NEEDS_ATTENTION
  REQUIRES_REPLACEMENT
  RETIRED
}

enum AltarProtocolType {
  DAILY_CLEANING
  INCENSE_INSERTION
  WATER_REFRESH
  FLOWER_REPLACEMENT
  LAMP_CHECK
  MONTHLY_DEEP_CLEAN
}

// ─── ALTAR-MANAGEMENT: Models ────────────────────────────────────────────────

model AltarItem {
  id            String               @id @default(cuid())
  publicId      String               @unique @map("public_id")
  userId        String               @map("user_id")
  itemType      AltarItemType        @map("item_type")
  name          String
  condition     AltarConditionStatus @default(GOOD)
  acquisitionAt DateTime?            @map("acquisition_at")
  notes         String?
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  user           User                 @relation("altarItems", fields: [userId], references: [id])
  validationLogs AltarValidationLog[]

  @@index([userId, isActive])
  @@index([itemType])
  @@map("altar_items")
}

model AltarValidationLog {
  id           String            @id @default(cuid())
  altarItemId  String?           @map("altar_item_id")
  userId       String            @map("user_id")
  protocolType AltarProtocolType @map("protocol_type")
  passed       Boolean
  notes        String?
  performedAt  DateTime          @map("performed_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  altarItem AltarItem? @relation(fields: [altarItemId], references: [id])
  user      User       @relation("altarValidationLogs", fields: [userId], references: [id])

  @@index([userId, performedAt(sort: Desc)])
  @@index([altarItemId])
  @@map("altar_validation_logs")
}

model AltarProtocolTemplate {
  id           String            @id @default(cuid())
  protocolType AltarProtocolType @map("protocol_type")
  titleVi      String            @map("title_vi")
  steps        Json
  frequency    String
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([protocolType, isActive])
  @@map("altar_protocol_templates")
}

// ============================================================================
// ENGAGEMENT: Reactions & Bookmarks
// ============================================================================

enum ReactionType {
  LIKE
  PRAY
  INSPIRE
  GRATITUDE
}

enum EngagementTargetType {
  POST
  COMMENT
  COMMUNITY_POST
}

enum BookmarkTargetType {
  POST
  EVENT
  SUTRA
  GUIDE
}

model ContentReaction {
  id         String              @id @default(cuid())
  actorId    String              @map("actor_id")
  targetType EngagementTargetType @map("target_type")
  targetId   String              @map("target_id")
  reaction   ReactionType
  createdAt  DateTime            @default(now()) @map("created_at")

  actor User @relation("contentReactions", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("content_reactions")
}

model ContentBookmark {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  targetType BookmarkTargetType @map("target_type")
  targetId   String             @map("target_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  user User @relation("contentBookmarks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
  @@map("content_bookmarks")
}

// ============================================================================
// WISDOM QA: Public Questions & Answers
// ============================================================================

enum WisdomQuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

model WisdomQuestion {
  id          String               @id @default(cuid())
  publicId    String               @unique @map("public_id")
  authorId    String               @map("author_id")
  title       String
  body        String               @db.Text
  categoryId  String?              @map("category_id")
  tags        String[]             @default([])
  isAnonymous Boolean              @default(false) @map("is_anonymous")
  status      WisdomQuestionStatus @default(OPEN)
  answerCount Int                  @default(0) @map("answer_count")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  author  User            @relation("wisdomQuestions", fields: [authorId], references: [id])
  answers WisdomAnswer[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("wisdom_questions")
}

model WisdomAnswer {
  id         String   @id @default(cuid())
  publicId   String   @unique @map("public_id")
  questionId String   @map("question_id")
  authorId   String   @map("author_id")
  body       String   @db.Text
  isAccepted Boolean  @default(false) @map("is_accepted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question WisdomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User           @relation("wisdomAnswers", fields: [authorId], references: [id])

  @@index([questionId])
  @@index([authorId])
  @@map("wisdom_answers")
}

// ============================================================================
// DAILY PRACTICE: Guides, Presets, FAQ
// ============================================================================

enum PracticeGuideLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model PracticeGuide {
  id          String             @id @default(cuid())
  publicId    String             @unique @map("public_id")
  title       String
  slug        String             @unique
  body        String             @db.Text
  duration    Int                @default(0)   // minutes
  difficulty  PracticeGuideLevel @default(BEGINNER)
  status      ContentStatus      @default(DRAFT)
  sortOrder   Int                @default(0) @map("sort_order")
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([difficulty])
  @@map("practice_guides")
}

model ScenarioPreset {
  id            String   @id @default(cuid())
  publicId      String   @unique @map("public_id")
  name          String
  scenarioType  String   @map("scenario_type")
  practiceCount Int      @default(0) @map("practice_count")
  guideIds      String[] @default([]) @map("guide_ids")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([scenarioType])
  @@map("scenario_presets")
}

model PracticeFaq {
  id        String   @id @default(cuid())
  publicId  String   @unique @map("public_id")
  question  String
  answer    String   @db.Text
  category  String   @default("general")
  featured  Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, featured])
  @@map("practice_faqs")
}

// ============================================================================
// DAILY RECITATION: Schedules, Guidelines, Routines
// ============================================================================

enum RecitationDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RecitationStatus {
  DRAFT
  PUBLISHED
}

enum GuidelineImportance {
  CRITICAL
  IMPORTANT
  REFERENCE
}

model PracticeSchedule {
  id              String               @id @default(cuid())
  publicId        String               @unique @map("public_id")
  name            String
  description     String               @db.Text
  difficulty      RecitationDifficulty @default(BEGINNER)
  dailyMinutes    Int                  @default(30) @map("daily_minutes")
  scriptureList   Json                 @default("[]") @map("scripture_list")
  minRecitations  Int                  @default(1) @map("min_recitations")
  maxRecitations  Int?                 @map("max_recitations")
  status          RecitationStatus     @default(DRAFT)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  guidelines RecitationGuideline[]
  routines   DailyRoutine[]

  @@index([status, difficulty])
  @@map("practice_schedules")
}

model RecitationGuideline {
  id         String              @id @default(cuid())
  publicId   String              @unique @map("public_id")
  scheduleId String              @map("schedule_id")
  topic      String
  guidance   String              @db.Text
  importance GuidelineImportance @default(IMPORTANT)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  schedule PracticeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, importance])
  @@map("recitation_guidelines")
}

model DailyRoutine {
  id                String   @id @default(cuid())
  publicId          String   @unique @map("public_id")
  scheduleId        String   @map("schedule_id")
  dayNumber         Int      @map("day_number")
  scriptureSequence String[] @default([]) @map("scripture_sequence")
  timing            String   @default("")
  notes             String   @default("")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  schedule PracticeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayNumber])
  @@index([scheduleId])
  @@map("daily_routines")
}

// ─── PLATFORM: Outbox Event Pattern ──────────────────────────────────────────

model OutboxEvent {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  eventType   String    @db.VarChar(255) @map("event_type")
  aggregateId String    @db.VarChar(255) @map("aggregate_id")
  payload     Json
  error       String?   @db.Text
  retryCount  Int       @default(0) @map("retry_count")

  @@index([processedAt, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("outbox_events")
}
