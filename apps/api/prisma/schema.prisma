// Phase 12 Logic 3: Sutra Type Metadata for E-Reader
// Classifies sutras/mantras as LONG (pausable) or SHORT (must restart)
model SutraMetadata {
  id               String    @id @default(cuid())
  publicId         String    @unique @map("public_id")
  sutraKey         String    @unique @map("sutra_key") // e.g., "da_bei_zhou", "wang_sheng_chu"
  titleVi          String    @map("title_vi")
  titleEn          String?   @map("title_en")
  sutraType        SutraType // LONG or SHORT
  pauseMantra      String?   @map("pause_mantra") // "Ong Lai Mu Suo He" for LONG types
  pauseInstruction String?   @map("pause_instruction")
  restartWarning   String?   @map("restart_warning") // Warning for SHORT types
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([sutraType])
  @@map("sutra_metadata")
}

// Phase 12 Logic 5: Dream Journal for Abortion Spirit Tracking
model DreamJournal {
  id                   String                   @id @default(cuid())
  publicId             String                   @unique @map("public_id")
  userId               String                   @map("user_id")
  dreamDate            DateTime                 @db.Date @map("dream_date")
  abortionChildRelated Boolean                  @default(false) @map("abortion_child_related")
  childState           DreamAbortionChildState? @map("child_state")
  description          String?
  littleHousePublicId  String?                  @map("little_house_public_id") // Link to related LH
  resolutionStatus     String?                  @default("UNRESOLVED") @map("resolution_status") // UNRESOLVED, RESOLVED
  autoActionTriggered  Boolean                  @default(false) @map("auto_action_triggered") // True if auto-created LH
  autoActionNote       String?                  @map("auto_action_note")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([userId])
  @@index([dreamDate])
  @@index([abortionChildRelated])
  @@index([resolutionStatus])
  @@map("dream_journals")
}

// Phase 12 Logic 1: Little House Stale Warning Records
