// PMTL Phase 1 schema
// Reference: design/04-execution-overlay/data/PRISMA_SCHEMA_PLAN.md

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["strictUndefinedChecks", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetStatus {
  UPLOADING
  READY
  ORPHANED
  DELETED
}

enum MediaCollectionType {
  PHOTO_ALBUM
  VIDEO_PLAYLIST
  MIXED_GALLERY
  FEATURED_STORY_GALLERY
}

enum MediaItemType {
  IMAGE
  VIDEO_EMBED
  UPLOADED_VIDEO
  POSTER
  EXTERNAL_PLAYLIST_LINK
}

// ============================================================================
// PLATFORM TABLES
// ============================================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorType  String   @map("actor_type")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitRecord {
  id         String   @id @default(cuid())
  key        String
  endpoint   String
  count      Int      @default(1)
  windowStart DateTime @map("window_start")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([key, endpoint, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_records")
}

// ============================================================================
// IDENTITY TABLES
// ============================================================================

model User {
  id           String     @id @default(cuid())
  publicId     String     @unique @map("public_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  posts               Post[]
  mediaAssets         MediaAsset[]
  mediaCollections    MediaCollection[]    @relation("collectionCreator")
  communityPosts      CommunityPost[]      @relation("communityPosts")
  guestbookEntries    GuestbookEntry[]     @relation("guestbookEntries")
  guestbookApprovals  GuestbookEntry[]     @relation("guestbookApprovals")
  calendarEvents      CalendarEvent[]      @relation("calendarEvents")
  pushSubscriptions   PushSubscription[]   @relation("pushSubscriptions")
  pushJobs            PushJob[]            @relation("pushJobs")
  beginnerGuides      BeginnerGuide[]      @relation("beginnerGuides")
  downloads           Download[]           @relation("downloads")
  vows                Vow[]                @relation("vows")
  lifeReleaseJournals LifeReleaseJournal[] @relation("lifeReleaseJournals")
  lifeReleaseActors   LifeReleaseJournal[] @relation("lifeReleaseActors")
  littleHouses        LittleHouse[]        @relation("littleHouses")
  dailyGongkeLogs     DailyGongkeLog[]     @relation("dailyGongkeLogs")
  repentanceLogs      RepentanceLog[]      @relation("repentanceLogs")
  altarLogs           AltarLog[]           @relation("altarLogs")
  activationLogs      ActivationLog[]      @relation("activationLogs")
  practiceProfile     PracticeProfile?     @relation("practiceProfile")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// CONTENT TABLES
// ============================================================================

model MediaAsset {
  id          String      @id @default(cuid())
  publicId    String      @unique @map("public_id")
  filename    String
  mimeType    String      @map("mime_type")
  size        Int
  storageKey  String      @map("storage_key")
  url         String
  width       Int?
  height      Int?
  status      AssetStatus @default(UPLOADING)
  uploaderId  String      @map("uploader_id")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  uploader         User                    @relation(fields: [uploaderId], references: [id])
  collectionItems  MediaCollectionItem[]
  coveredCollections MediaCollection[]     @relation("collectionCover")

  @@index([uploaderId])
  @@index([status])
  @@map("media_assets")
}

model MediaCollection {
  id             String              @id @default(cuid())
  publicId       String              @unique @map("public_id")
  title          String
  slug           String              @unique
  description    String?
  collectionType MediaCollectionType @map("collection_type")
  coverMediaId   String?             @map("cover_media_id")
  sourceNote     String?             @map("source_note")
  featured       Boolean             @default(false)
  sortOrder      Int                 @default(0) @map("sort_order")
  status         ContentStatus       @default(DRAFT)
  createdById    String              @map("created_by_id")
  publishedAt    DateTime?           @map("published_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  createdBy  User                  @relation("collectionCreator", fields: [createdById], references: [id])
  coverMedia MediaAsset?           @relation("collectionCover", fields: [coverMediaId], references: [id])
  items      MediaCollectionItem[]

  @@index([status])
  @@index([collectionType])
  @@index([featured])
  @@index([createdById])
  @@map("media_collections")
}

model MediaCollectionItem {
  id             String         @id @default(cuid())
  publicId       String         @unique @map("public_id")
  collectionId   String         @map("collection_id")
  itemType       MediaItemType  @map("item_type")
  mediaAssetId   String?        @map("media_asset_id")
  externalUrl    String?        @map("external_url")
  title          String?
  caption        String?
  ownerModule    String?        @map("owner_module")
  ownerPublicRef String?        @map("owner_public_ref")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?     @relation(fields: [mediaAssetId], references: [id])

  @@index([collectionId])
  @@index([mediaAssetId])
  @@map("media_collection_items")
}

model Post {
  id          String        @id @default(cuid())
  publicId    String        @unique @map("public_id")
  slug        String        @unique
  title       String
  excerpt     String?
  content     Json
  status      ContentStatus @default(DRAFT)
  authorId    String        @map("author_id")
  featuredImageId String?   @map("featured_image_id")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@map("posts")
}

// ============================================================================
// CHANTING ENVIRONMENT RULES
// Canonical rule surface for /niem-kinh/luu-y-moi-truong-va-thoi-gian
// ============================================================================

enum RuleSeverity {
  ADVISORY
  CAUTION
  STRONG_GUARDRAIL
  QUALITY_GUIDANCE
  REFERENCE_ONLY
}

enum RuleProductizationMode {
  WARNING_CARD
  CHECKLIST_ITEM
  SAFE_LANE_SUGGESTION
  DRAWER_NOTE
  REFERENCE_ONLY_NOTE
  DO_NOT_AUTOMATE
}

model ChantEnvironmentRuleGroup {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  groupKey        String   @unique @map("group_key")
  title           String
  summary         String
  sortOrder       Int      @default(0) @map("sort_order")
  lastReviewedAt  DateTime @default(now()) @map("last_reviewed_at")
  versionNote     String?  @map("version_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rules ChantEnvironmentRule[]

  @@map("chant_environment_rule_groups")
}

model ChantEnvironmentRule {
  id                  String                  @id @default(cuid())
  publicId            String                  @unique @map("public_id")
  groupId             String                  @map("group_id")
  ruleKey             String                  @unique @map("rule_key")
  title               String
  canonicalWording    String                  @map("canonical_wording")
  severity            RuleSeverity
  productizationMode  RuleProductizationMode  @map("productization_mode")
  safeLaneRefs        String[]                @default([]) @map("safe_lane_refs")
  avoidItems          String[]                @default([]) @map("avoid_items")
  shortReason         String?                 @map("short_reason")
  sourceReference     String?                 @map("source_reference")
  versionNote         String?                 @map("version_note")
  referenceOnly       Boolean                 @default(false) @map("reference_only")
  sortOrder           Int                     @default(0) @map("sort_order")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  group ChantEnvironmentRuleGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("chant_environment_rules")
}

// ============================================================================
// WEBHOOK DEDUPLICATION
// ============================================================================

model WebhookDelivery {
  id          String   @id @default(cuid())
  provider    String                          // e.g. "stripe", "payos", "cloudflare"
  eventId     String   @map("event_id")       // provider's unique event/delivery ID
  eventType   String   @map("event_type")     // e.g. "payment.completed"
  status      String   @default("PROCESSED")  // PROCESSED | FAILED
  metadata    Json?
  processedAt DateTime @default(now()) @map("processed_at")
  expiresAt   DateTime @map("expires_at")     // TTL for cleanup

  @@unique([provider, eventId])
  @@index([expiresAt])
  @@index([provider, eventType])
  @@map("webhook_deliveries")
}

// ============================================================================
// MODERATION TABLES
// ============================================================================

enum CommunityPostStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum GuestbookEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum PushJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VowStatus {
  ACTIVE
  COMPLETED
  VOIDED
}

enum VowType {
  LIFE_RELEASE
  CHANTING
  SUTRA_READING
  CUSTOM
}

enum GuideCategory {
  BEGINNER
  DAILY_PRACTICE
  LITTLE_HOUSE
  LIFE_RELEASE
  GENERAL
}

enum DownloadCategory {
  GUIDE
  TEMPLATE
  REFERENCE
  FAQ
}

enum ReportStatus {
  PENDING
  RESOLVED_HIDE
  RESOLVED_IGNORE
  RESOLVED_ESCALATE
}

// ============================================================================
// COMMUNITY TABLES
// ============================================================================

model CommunityPost {
  id               String              @id @default(cuid())
  publicId         String              @unique @map("public_id")
  authorId         String              @map("author_id")
  content          String
  status           CommunityPostStatus @default(PENDING)
  heartCount       Int                 @default(0) @map("heart_count")
  commentCount     Int                 @default(0) @map("comment_count")
  reportCount      Int                 @default(0) @map("report_count")
  isHidden         Boolean             @default(false) @map("is_hidden")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  author User @relation("communityPosts", fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("community_posts")
}

model GuestbookEntry {
  id            String              @id @default(cuid())
  publicId      String              @unique @map("public_id")
  authorId      String              @map("author_id")
  content       String
  status        GuestbookEntryStatus @default(PENDING)
  approvedById  String?             @map("approved_by_id")
  approvedAt    DateTime?           @map("approved_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  author     User  @relation("guestbookEntries", fields: [authorId], references: [id])
  approvedBy User? @relation("guestbookApprovals", fields: [approvedById], references: [id])

  @@index([authorId])
  @@index([status])
  @@map("guestbook_entries")
}

// ============================================================================
// CALENDAR TABLES
// ============================================================================

model CalendarEvent {
  id            String      @id @default(cuid())
  publicId      String      @unique @map("public_id")
  title         String
  description   String?
  startAt       DateTime    @map("start_at")
  endAt         DateTime?   @map("end_at")
  location      String?
  eventType     String      @default("general") @map("event_type")
  status        EventStatus @default(DRAFT)
  createdById   String      @map("created_by_id")
  publishedAt   DateTime?   @map("published_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  createdBy User @relation("calendarEvents", fields: [createdById], references: [id])

  @@index([status])
  @@index([startAt])
  @@index([createdById])
  @@map("calendar_events")
}

// ============================================================================
// VOLUNTEER & CONTACT TABLES
// ============================================================================

model Volunteer {
  id          String   @id @default(cuid())
  publicId    String   @unique @map("public_id")
  displayName String   @map("display_name")
  role        String
  avatarUrl   String?  @map("avatar_url")
  phone       String?
  zaloLink    String?  @map("zalo_link")
  bio         String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("volunteers")
}

enum ContactSubmissionStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactSubmission {
  id        String                  @id @default(cuid())
  publicId  String                  @unique @default(nanoid()) @map("public_id")
  name      String
  email     String
  subject   String
  message   String
  status    ContactSubmissionStatus @default(PENDING)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model ContactInfo {
  id          String   @id @default(cuid())
  publicId    String   @unique @map("public_id")
  title       String   @default("Phật Mẫu Tâm Linh")
  email       String?
  phone       String?
  address     String?
  socialLinks Json?    @map("social_links")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contact_info")
}

// ============================================================================
// NOTIFICATION TABLES
// ============================================================================

model PushSubscription {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  userId          String   @map("user_id")
  endpoint        String
  isActive        Boolean  @default(true) @map("is_active")
  subscribedAt    DateTime @default(now()) @map("subscribed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation("pushSubscriptions", fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model PushJob {
  id              String        @id @default(cuid())
  publicId        String        @unique @map("public_id")
  title           String
  body            String
  status          PushJobStatus @default(PENDING)
  targetAudience  String?       @map("target_audience")
  sentCount       Int           @default(0) @map("sent_count")
  failedCount     Int           @default(0) @map("failed_count")
  createdById     String        @map("created_by_id")
  processedAt     DateTime?     @map("processed_at")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  createdBy User @relation("pushJobs", fields: [createdById], references: [id])

  @@index([status])
  @@index([createdById])
  @@map("push_jobs")
}

// ============================================================================
// CONTENT EXTENSION TABLES
// ============================================================================

model BeginnerGuide {
  id          String        @id @default(cuid())
  publicId    String        @unique @map("public_id")
  title       String
  slug        String        @unique
  content     Json
  excerpt     String?
  category    GuideCategory @default(BEGINNER)
  status      ContentStatus @default(DRAFT)
  authorId    String        @map("author_id")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  author User @relation("beginnerGuides", fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
  @@index([category])
  @@map("beginner_guides")
}

model Download {
  id          String           @id @default(cuid())
  publicId    String           @unique @map("public_id")
  title       String
  description String?
  category    DownloadCategory @default(GUIDE)
  fileUrl     String           @map("file_url")
  fileType    String           @map("file_type")
  fileSize    Int              @default(0) @map("file_size")
  status      ContentStatus    @default(DRAFT)
  uploaderId  String           @map("uploader_id")
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  uploader User @relation("downloads", fields: [uploaderId], references: [id])

  @@index([uploaderId])
  @@index([status])
  @@index([category])
  @@map("downloads")
}

// ============================================================================
// VOWS & MERIT TABLES
// ============================================================================

model Vow {
  id            String    @id @default(cuid())
  publicId      String    @unique @map("public_id")
  userId        String    @map("user_id")
  vowType       VowType   @map("vow_type")
  description   String
  targetCount   Int?      @map("target_count")
  currentCount  Int       @default(0) @map("current_count")
  status        VowStatus @default(ACTIVE)
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User                    @relation("vows", fields: [userId], references: [id])
  entries       LifeReleaseJournal[]
  meritTransfers MeritTransfer[]

  @@index([userId])
  @@index([status])
  @@map("vows")
}

model LifeReleaseJournal {
  id           String   @id @default(cuid())
  publicId     String   @unique @map("public_id")
  userId       String   @map("user_id")
  vowId        String?  @map("vow_id")
  journalDate  DateTime @map("journal_date")
  animalType   String   @map("animal_type")
  quantity     Int
  location     String?
  note         String?
  actorUserId  String?  @map("actor_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User  @relation("lifeReleaseJournals", fields: [userId], references: [id])
  vow   Vow?  @relation(fields: [vowId], references: [id])
  actor User? @relation("lifeReleaseActors", fields: [actorUserId], references: [id])

  @@index([userId])
  @@index([vowId])
  @@index([journalDate])
  @@map("life_release_journals")
}

// ============================================================================
// MODERATION TABLES
// ============================================================================

model ModerationReport {
  id              String       @id @default(cuid())
  publicId        String       @unique @map("public_id")
  reporterUserId  String       @map("reporter_user_id")
  targetType      String       @map("target_type") // "post" | "comment" | "community_post" | "guestbook"
  targetId        String       @map("target_id")
  reasonCode      String       @map("reason_code")
  description     String?
  status          ReportStatus @default(PENDING)
  decisionBy      String?      @map("decision_by")
  decisionAt      DateTime?    @map("decision_at")
  decisionNote    String?      @map("decision_note")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterUserId])
  @@map("moderation_reports")
}

// ============================================================================
// PRACTICE CORE MODULE ENUMS
// ============================================================================

enum LittleHouseStatus {
  DRAFT
  SIGNED
  CHANTED
  BURNED
}

enum AltarActionType {
  INCENSE
  MAINTENANCE
  MOVE
  HEART_INCENSE
}

enum SymptomTag {
  PAIN
  BAD_DREAM
  FAMILY_CONFLICT
  OTHER
}

// ============================================================================
// PRACTICE CORE MODULE TABLES
// Module owners: engagement (gongke, repentance, little house, activation, elderly)
//                vows-merit (altar, merit transfer)
// ============================================================================

// Module 1 — LittleHouseLifecycle
// Owner: engagement (self-state/lifecycle) + content (ritual copy ref)
model LittleHouse {
  id           String            @id @default(cuid())
  publicId     String            @unique @map("public_id")
  userId       String            @map("user_id")
  recipient    String
  sheetsCount  Int               @default(1) @map("sheets_count")
  status       LittleHouseStatus @default(DRAFT)
  burnDate     DateTime?         @map("burn_date")
  postBurnNote String?           @map("post_burn_note")
  specialCase  Boolean           @default(false) @map("special_case")
  confirmedAt  DateTime?         @map("confirmed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User @relation("littleHouses", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("little_houses")
}

// Module 2 — VowMeritEngine (merit transfer sub-record)
// Owner: vows-merit
model MeritTransfer {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  vowId           String   @map("vow_id")
  transferPercent Int      @map("transfer_percent")
  targetLabel     String   @map("target_label")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vow Vow @relation(fields: [vowId], references: [id])

  @@index([vowId])
  @@map("merit_transfers")
}

// Module 3 — DailyGongkeTracker
// Owner: engagement
model DailyGongkeLog {
  id             String   @id @default(cuid())
  publicId       String   @unique @map("public_id")
  userId         String   @map("user_id")
  date           DateTime @db.Date
  coreCountsJson Json     @map("core_counts_json")
  busyMode       Boolean  @default(false) @map("busy_mode")
  heartIncense   Boolean  @default(false) @map("heart_incense")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation("dailyGongkeLogs", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_gongke_logs")
}

// Module 4 — RepentanceJournal
// Owner: engagement
model RepentanceLog {
  id          String   @id @default(cuid())
  publicId    String   @unique @map("public_id")
  userId      String   @map("user_id")
  date        DateTime @db.Date
  count       Int      @default(0)
  privateNote String?  @map("private_note")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation("repentanceLogs", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("repentance_logs")
}

// Module 5 — AltarMaintenanceGuard
// Owner: vows-merit
model AltarLog {
  id                 String          @id @default(cuid())
  publicId           String          @unique @map("public_id")
  userId             String          @map("user_id")
  date               DateTime        @db.Date
  actionType         AltarActionType @map("action_type")
  checklistStateJson Json            @map("checklist_state_json")
  note               String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user User @relation("altarLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@map("altar_logs")
}

// Module 6 — ElderlyPracticeMode
// Owner: engagement
model PracticeProfile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  elderlyMode      Boolean  @default(false) @map("elderly_mode")
  assistMode       Boolean  @default(false) @map("assist_mode")
  assistContactRef String?  @map("assist_contact_ref")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation("practiceProfile", fields: [userId], references: [id])

  @@map("practice_profiles")
}

// Module 7 — LinhTinhActivationGuard
// Owner: engagement
model ActivationLog {
  id                   String     @id @default(cuid())
  publicId             String     @unique @map("public_id")
  userId               String     @map("user_id")
  date                 DateTime   @db.Date
  symptomTag           SymptomTag @map("symptom_tag")
  suggestedActionsJson Json       @map("suggested_actions_json")
  privateNote          String?    @map("private_note")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  user User @relation("activationLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@map("activation_logs")
}
