// PMTL Phase 1 schema
// Reference: design/04-execution-overlay/data/PRISMA_SCHEMA_PLAN.md

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["strictUndefinedChecks", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostType {
  ARTICLE
  TRANSCRIPT
  SOURCE_NOTE
  EVENT_RECAP
}

enum AssetStatus {
  UPLOADING
  READY
  ORPHANED
  DELETED
}

enum WisdomEntryType {
  BACH_THOAI
  KHAI_THI
  PHAT_NGON
  PHAP_HOI
}

enum MediaCollectionType {
  PHOTO_ALBUM
  VIDEO_PLAYLIST
  MIXED_GALLERY
  FEATURED_STORY_GALLERY
}

enum MediaItemType {
  IMAGE
  VIDEO_EMBED
  UPLOADED_VIDEO
  POSTER
  EXTERNAL_PLAYLIST_LINK
}

// ============================================================================
// PLATFORM TABLES
// ============================================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorType  String   @map("actor_type")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitRecord {
  id         String   @id @default(cuid())
  key        String
  endpoint   String
  count      Int      @default(1)
  windowStart DateTime @map("window_start")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([key, endpoint, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_records")
}

// ============================================================================
// IDENTITY TABLES
// ============================================================================

model User {
  id           String     @id @default(cuid())
  publicId     String     @unique @map("public_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  posts               Post[]
  mediaAssets         MediaAsset[]
  mediaCollections    MediaCollection[]    @relation("collectionCreator")
  communityPosts      CommunityPost[]      @relation("communityPosts")
  communityTestimonials CommunityTestimonial[] @relation("communityTestimonials")
  guestbookEntries    GuestbookEntry[]     @relation("guestbookEntries")
  guestbookApprovals  GuestbookEntry[]     @relation("guestbookApprovals")
  calendarEvents      CalendarEvent[]      @relation("calendarEvents")
  pushSubscriptions        PushSubscription[]        @relation("pushSubscriptions")
  pushJobs                 PushJob[]                 @relation("pushJobs")
  notificationPreferences  NotificationPreference?   @relation("notificationPreferences")
  beginnerGuides      BeginnerGuide[]      @relation("beginnerGuides")
  downloads           Download[]           @relation("downloads")
  chantingSessions    ChantingSession[]    @relation("chantingSessions")
  vows                Vow[]                @relation("vows")
  lifeReleaseJournals LifeReleaseJournal[] @relation("lifeReleaseJournals")
  lifeReleaseActors   LifeReleaseJournal[] @relation("lifeReleaseActors")
  littleHouses        LittleHouse[]        @relation("littleHouses")
  dailyGongkeLogs     DailyGongkeLog[]     @relation("dailyGongkeLogs")
  repentanceLogs      RepentanceLog[]      @relation("repentanceLogs")
  altarLogs           AltarLog[]           @relation("altarLogs")
  activationLogs      ActivationLog[]      @relation("activationLogs")
  practiceProfile     PracticeProfile?     @relation("practiceProfile")
  wisdomEntries       WisdomEntry[]        @relation("wisdomEntries")
  selfCultivationSheets SelfCultivationSheet[] @relation("selfCultivationSheets")

  passwordResetTokens      PasswordResetToken[]      @relation("passwordResetTokens")
  emailVerificationTokens  EmailVerificationToken[]  @relation("emailVerificationTokens")
  communityComments   CommunityComment[]   @relation("communityComments")
  communityHearts     CommunityHeart[]     @relation("communityHearts")

  // Phase 12 relations
  convincingFamilyRituals ConvincingFamilyRitualSession[] @relation("convincingFamilyRituals")
  nameChangeApplications  NameChangeApplication[]         @relation("nameChangeApplications")
  sutraReadingSessions    SutraReadingSession[]           @relation("sutraReadingSessions")
  sutraBookmarks          SutraBookmark[]                 @relation("sutraBookmarks")
  littleHouseBurnSessions LittleHouseBurnSession[]        @relation("littleHouseBurnSessions")
  childProfiles           ChildProfile[]                  @relation("childProfiles")
  altarProfile            AltarProfile?                   @relation("altarProfile")
  waterOfferingLogs       WaterOfferingLog[]              @relation("waterOfferingLogs")
  deceasedRelatives       DeceasedRelative[]              @relation("deceasedRelatives")

  // Phase 6-domains relations
  userCharityInteractions UserCharityInteraction[]        @relation("userCharityInteractions")
  practitionerVows        MaritalPurityVow[]              @relation("practitionerVows")
  organizedEvents         BuddhistEvent[]                 @relation("organizedEvents")
  lifeReleaseRecords      LifeReleaseRecord[]             @relation("lifeReleaseRecords")
  proxySponsorReleases    ProxyLifeRelease[]              @relation("proxySponsorReleases")
  sacredFormApplicants    FormApplicant[]                 @relation("sacredFormApplicants")
  nameChangeProbations    NameChangeProbation[]           @relation("nameChangeProbations")
  altarItems              AltarItem[]                     @relation("altarItems")
  altarValidationLogs     AltarValidationLog[]            @relation("altarValidationLogs")
  lhRecords               LhRecord[]                      @relation("lhRecords")
  eventRegistrations      EventRegistration[]             @relation("eventRegistrations")

  // Engagement relations
  contentReactions        ContentReaction[]               @relation("contentReactions")
  contentBookmarks        ContentBookmark[]               @relation("contentBookmarks")

  // Wisdom QA relations
  wisdomQuestions         WisdomQuestion[]                @relation("wisdomQuestions")
  wisdomAnswers           WisdomAnswer[]                  @relation("wisdomAnswers")

  @@index([email])
  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("passwordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation("emailVerificationTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// CONTENT TABLES
// ============================================================================

model MediaAsset {
  id          String      @id @default(cuid())
  publicId    String      @unique @map("public_id")
  filename    String
  mimeType    String      @map("mime_type")
  size        Int
  storageKey  String      @map("storage_key")
  url         String
  width       Int?
  height      Int?
  status      AssetStatus @default(UPLOADING)
  uploaderId  String      @map("uploader_id")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  uploader         User                    @relation(fields: [uploaderId], references: [id])
  collectionItems  MediaCollectionItem[]
  coveredCollections MediaCollection[]     @relation("collectionCover")
  postFeaturedImages Post[]                @relation("postFeaturedImage")
  guideCoverMedia BeginnerGuide[]          @relation("guideCoverMedia")
  downloadFileMedia Download[]             @relation("downloadFileMedia")
  downloadThumbnailMedia Download[]        @relation("downloadThumbnailMedia")
  calendarCoverImages CalendarEvent[]      @relation("calendarCoverImage")
  calendarPosterImages CalendarEvent[]     @relation("calendarPosterImage")
  selfCultivationTemplatePdfs SelfCultivationTemplate[] @relation("templatePdfMedia")

  @@index([uploaderId])
  @@index([status])
  @@map("media_assets")
}

model MediaCollection {
  id             String              @id @default(cuid())
  publicId       String              @unique @map("public_id")
  title          String
  slug           String              @unique
  description    String?
  collectionType MediaCollectionType @map("collection_type")
  coverMediaId   String?             @map("cover_media_id")
  sourceNote     String?             @map("source_note")
  featured       Boolean             @default(false)
  sortOrder      Int                 @default(0) @map("sort_order")
  status         ContentStatus       @default(DRAFT)
  createdById    String              @map("created_by_id")
  publishedAt    DateTime?           @map("published_at")
  firstPublishedAt DateTime?         @map("first_published_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  createdBy  User                  @relation("collectionCreator", fields: [createdById], references: [id])
  coverMedia MediaAsset?           @relation("collectionCover", fields: [coverMediaId], references: [id])
  items      MediaCollectionItem[]

  @@index([status])
  @@index([collectionType])
  @@index([featured])
  @@index([createdById])
  @@map("media_collections")
}

model MediaCollectionItem {
  id             String         @id @default(cuid())
  publicId       String         @unique @map("public_id")
  collectionId   String         @map("collection_id")
  itemType       MediaItemType  @map("item_type")
  mediaAssetId   String?        @map("media_asset_id")
  externalUrl    String?        @map("external_url")
  title          String?
  caption        String?
  ownerModule    String?        @map("owner_module")
  ownerPublicRef String?        @map("owner_public_ref")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?     @relation(fields: [mediaAssetId], references: [id])

  @@index([collectionId])
  @@index([mediaAssetId])
  @@map("media_collection_items")
}

model PostCategory {
  id          String   @id @default(cuid())
  publicId    String   @unique @map("public_id")
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("post_categories")
}

model PostTag {
  id        String   @id @default(cuid())
  publicId  String   @unique @map("public_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts PostTagMap[]

  @@map("post_tags")
}

model PostTagMap {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tag_map")
}

model Post {
  id                String        @id @default(cuid())
  publicId          String        @unique @map("public_id")
  slug              String        @unique
  title             String
  postType          PostType      @default(ARTICLE) @map("post_type")
  sourceRef         String?       @map("source_ref")
  content           Json
  status            ContentStatus @default(DRAFT)
  authorId          String        @map("author_id")
  primaryCategoryId String?       @map("primary_category_id")
  featuredImageId   String?       @map("featured_image_id")
  featured          Boolean       @default(false)
  allowComments     Boolean       @default(true) @map("allow_comments")
  publishedAt       DateTime?     @map("published_at")
  firstPublishedAt  DateTime?     @map("first_published_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  author          User          @relation(fields: [authorId], references: [id])
  primaryCategory PostCategory? @relation(fields: [primaryCategoryId], references: [id])
  featuredImage   MediaAsset?   @relation("postFeaturedImage", fields: [featuredImageId], references: [id])
  tags            PostTagMap[]

  @@index([authorId])
  @@index([status])
  @@index([postType])
  @@index([featured])
  @@index([publishedAt])
  @@map("posts")
}

// ============================================================================
// CHANTING ENVIRONMENT RULES
// Canonical rule surface for /niem-kinh/luu-y-moi-truong-va-thoi-gian
// ============================================================================

enum RuleSeverity {
  ADVISORY
  CAUTION
  STRONG_GUARDRAIL
  QUALITY_GUIDANCE
  REFERENCE_ONLY
}

enum RuleProductizationMode {
  WARNING_CARD
  CHECKLIST_ITEM
  SAFE_LANE_SUGGESTION
  DRAWER_NOTE
  REFERENCE_ONLY_NOTE
  DO_NOT_AUTOMATE
}

model ChantEnvironmentRuleGroup {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  groupKey        String   @unique @map("group_key")
  title           String
  summary         String
  sortOrder       Int      @default(0) @map("sort_order")
  lastReviewedAt  DateTime @default(now()) @map("last_reviewed_at")
  versionNote     String?  @map("version_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rules ChantEnvironmentRule[]

  @@map("chant_environment_rule_groups")
}

model ChantEnvironmentRule {
  id                  String                  @id @default(cuid())
  publicId            String                  @unique @map("public_id")
  groupId             String                  @map("group_id")
  ruleKey             String                  @unique @map("rule_key")
  title               String
  canonicalWording    String                  @map("canonical_wording")
  severity            RuleSeverity
  productizationMode  RuleProductizationMode  @map("productization_mode")
  safeLaneRefs        String[]                @default([]) @map("safe_lane_refs")
  avoidItems          String[]                @default([]) @map("avoid_items")
  shortReason         String?                 @map("short_reason")
  sourceReference     String?                 @map("source_reference")
  versionNote         String?                 @map("version_note")
  referenceOnly       Boolean                 @default(false) @map("reference_only")
  sortOrder           Int                     @default(0) @map("sort_order")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  group ChantEnvironmentRuleGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("chant_environment_rules")
}

// ============================================================================
// WEBHOOK DEDUPLICATION
// ============================================================================

model WebhookDelivery {
  id          String   @id @default(cuid())
  provider    String                          // e.g. "stripe", "payos", "cloudflare"
  eventId     String   @map("event_id")       // provider's unique event/delivery ID
  eventType   String   @map("event_type")     // e.g. "payment.completed"
  status      String   @default("PROCESSED")  // PROCESSED | FAILED
  metadata    Json?
  processedAt DateTime @default(now()) @map("processed_at")
  expiresAt   DateTime @map("expires_at")     // TTL for cleanup

  @@unique([provider, eventId])
  @@index([expiresAt])
  @@index([provider, eventType])
  @@map("webhook_deliveries")
}

// ============================================================================
// MODERATION TABLES
// ============================================================================

enum CommunityPostStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum GuestbookEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum PushJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VowStatus {
  ACTIVE
  COMPLETED
  VOIDED
}

enum VowType {
  LIFE_RELEASE
  CHANTING
  SUTRA_READING
  CUSTOM
}

enum GuideCategory {
  BEGINNER
  DAILY_PRACTICE
  LITTLE_HOUSE
  LIFE_RELEASE
  GENERAL
  ALTAR_SETUP
  ALTAR_OFFERINGS
  ALTAR_MAINTENANCE
  HEART_INCENSE
}

enum DownloadCategory {
  GUIDE
  TEMPLATE
  REFERENCE
  FAQ
  SPIRITUAL_APPLICATION
}

enum ReportStatus {
  PENDING
  RESOLVED_HIDE
  RESOLVED_IGNORE
  RESOLVED_ESCALATE
}

// ============================================================================
// COMMUNITY TABLES
// ============================================================================

model CommunityPost {
  id               String              @id @default(cuid())
  publicId         String              @unique @map("public_id")
  authorId         String              @map("author_id")
  content          String
  status           CommunityPostStatus @default(PENDING)
  heartCount       Int                 @default(0) @map("heart_count")
  commentCount     Int                 @default(0) @map("comment_count")
  reportCount      Int                 @default(0) @map("report_count")
  isHidden         Boolean             @default(false) @map("is_hidden")
  isPinned         Boolean             @default(false) @map("is_pinned")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  author   User               @relation("communityPosts", fields: [authorId], references: [id])
  comments CommunityComment[]
  hearts   CommunityHeart[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("community_posts")
}

model GuestbookEntry {
  id            String              @id @default(cuid())
  publicId      String              @unique @map("public_id")
  authorId      String              @map("author_id")
  content       String
  status        GuestbookEntryStatus @default(PENDING)
  approvedById  String?             @map("approved_by_id")
  approvedAt    DateTime?           @map("approved_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  author     User  @relation("guestbookEntries", fields: [authorId], references: [id])
  approvedBy User? @relation("guestbookApprovals", fields: [approvedById], references: [id])

  @@index([authorId])
  @@index([status])
  @@map("guestbook_entries")
}

model CommunityComment {
  id        String   @id @default(cuid())
  publicId  String   @unique @map("public_id")
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation("communityComments", fields: [authorId], references: [id])

  @@index([postId])
  @@index([authorId])
  @@map("community_comments")
}

model CommunityHeart {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation("communityHearts", fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_hearts")
}

// CommunityTestimonial — Bài chia sẻ phụng sự viên với disclaimer tự động chèn
// Design: design/03-domains/community/USE_CASES/USE_CASE_TESTIMONIAL_DISCLAIMER_AUTO_INJECT.md
model CommunityTestimonial {
  id                 String   @id @default(cuid())
  publicId           String   @unique @map("public_id")
  authorId           String   @map("author_id")
  title              String   @db.VarChar(200)
  body               String   // includes auto-injected disclaimer at end
  originalBodyLength Int      @map("original_body_length")
  contentType        String   @map("content_type") // TESTIMONY | HEALING_STORY | LIFE_CHANGE | GENERAL_POST
  authorRole         String   @map("author_role")  // VOLUNTEER | ORGANIZER | MEMBER
  disclaimerInjected Boolean  @default(true) @map("disclaimer_injected")
  disclaimerText     String   @map("disclaimer_text")
  coverImage         String?  @map("cover_image")
  tags               String[] @default([])
  status             String   @default("PUBLISHED")
  visibility         String   @default("PUBLIC")
  viewCount          Int      @default(0) @map("view_count")
  likeCount          Int      @default(0) @map("like_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  author User @relation("communityTestimonials", fields: [authorId], references: [id])

  @@index([authorId])
  @@index([contentType])
  @@index([status])
  @@map("community_testimonials")
}

// ============================================================================
// CALENDAR TABLES
// ============================================================================

model CalendarEvent {
  id            String      @id @default(cuid())
  publicId      String      @unique @map("public_id")
  title         String
  description   String?
  startAt       DateTime    @map("start_at")
  endAt         DateTime?   @map("end_at")
  location      String?
  eventType     String      @default("general") @map("event_type")
  coverImageId  String?     @map("cover_image_id")
  posterImageId String?     @map("poster_image_id")
  status        EventStatus @default(DRAFT)
  createdById   String      @map("created_by_id")
  publishedAt   DateTime?   @map("published_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  createdBy User @relation("calendarEvents", fields: [createdById], references: [id])
  coverImage MediaAsset? @relation("calendarCoverImage", fields: [coverImageId], references: [id])
  posterImage MediaAsset? @relation("calendarPosterImage", fields: [posterImageId], references: [id])
  agendaItems EventAgendaItem[]

  @@index([status])
  @@index([startAt])
  @@index([createdById])
  @@index([coverImageId])
  @@index([posterImageId])
  @@map("calendar_events")
}

model EventAgendaItem {
  id          String   @id @default(cuid())
  publicId    String   @unique @map("public_id")
  eventId     String   @map("event_id")
  title       String
  description String?
  startTime   String?  @map("start_time")
  endTime     String?  @map("end_time")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_agenda_items")
}

// ============================================================================
// VOLUNTEER & CONTACT TABLES
// ============================================================================

model Volunteer {
  id          String   @id @default(cuid())
  publicId    String   @unique @map("public_id")
  displayName String   @map("display_name")
  role        String
  avatarUrl   String?  @map("avatar_url")
  phone       String?
  zaloLink    String?  @map("zalo_link")
  bio         String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("volunteers")
}

enum ContactSubmissionStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactSubmission {
  id        String                  @id @default(cuid())
  publicId  String                  @unique @default(nanoid()) @map("public_id")
