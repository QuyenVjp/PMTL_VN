{
  "annotations": { "list": [] },
  "description": "PMTL — PostgreSQL slow query governance via pg_stat_statements",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Max Query Duration",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_stat_statements_max_exec_time_seconds * 1000",
          "legendFormat": "Max exec time (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Top 10 Slowest Queries — Mean Exec Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, rate(pg_stat_statements_total_exec_time_seconds[5m]) / rate(pg_stat_statements_calls_total[5m])) * 1000",
          "legendFormat": "query: {{query}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 3,
      "title": "Query Call Rate (top 10)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, rate(pg_stat_statements_calls_total[5m]))",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1000 }] },
          "unit": "ms"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "calls" }, "properties": [{ "id": "unit", "value": "short" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "mean_ms" }]
      },
      "title": "All Slow Queries Table (mean > 1s)",
      "type": "table",
      "targets": [
        {
          "expr": "sort_desc(pg_stat_statements_mean_exec_time_seconds * 1000 > 1000)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "Value": "mean_ms", "query": "SQL Query" } } }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"orange","value":50},{"color":"red","value":200}] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Sequential Scans (large tables)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(pg_stat_user_tables_seq_scan[1h]))",
          "legendFormat": "seq scans / hour",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["postgres", "performance", "pmtl"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Ho_Chi_Minh",
  "title": "PMTL — Slow Query Governance",
  "uid": "pmtl-slow-queries",
  "version": 1
}
